# Copy this file to .env.local and fill in the values.
# .env.local is never committed. On Vercel, add the same names under
# Project → Settings → Environment Variables.

# --- Secret: server only (never prefix these with NEXT_PUBLIC_) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
FOOTBALL_DATA_TOKEN=
F1_USER_AGENT="ruhin-portfolio (personal website)"

# Set to 1 to use stand-in data for the live cards (tests and local work without keys).
LIVE_DATA_FIXTURES=

# --- Public: safe to appear in the browser ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Umami Cloud website ID (cloud.umami.is, Websites, Edit). Stats are only sent from rubaiyat.dev.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
